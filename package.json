{
  "name": "deck-rogue-proto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/sim/run.ts",
    "typecheck": "tsc -b",
    "test:variance": "VARIANCE=1 vitest run src/sim/variance.slow.test.ts",
    "ratings": "tsx scripts/aggregate-ratings.ts",
    "picks": "tsx scripts/aggregate-picks.ts",
    "analyze": "tsx scripts/analyze-run.ts",
    "goldens": "tsx scripts/dump-goldens.ts",
    "goldens:verify": "tsx scripts/verify-goldens.ts",
    "gen:csharp": "tsx scripts/gen-csharp-types.ts",
    "fusion:table": "tsx scripts/fusion-table.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
