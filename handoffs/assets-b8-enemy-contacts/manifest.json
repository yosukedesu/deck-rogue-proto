{
  "schema": "deckrogue.asset-handoff.v1",
  "bundle": "B8 enemy elemental contacts",
  "date": "2026-11-08",
  "branch": "codex/assets-b8-20261108",
  "source_reference_commit": "114ee430310c5a2df02ea048f23d1f8375c22c66",
  "status": "eight asset candidates complete; production integration and GPU rendering not verified",
  "generation": "original direct native integer-pixel drawing; no game sprite copied; no generative-image resizing",
  "theme": "night glass; fine brass plus elemental accents",
  "format": {
    "mode": "RGBA",
    "bit_depth": 8,
    "alpha_values": [
      0,
      255
    ],
    "filter": "nearest",
    "mipmaps": false,
    "compression": "lossless",
    "blend": "normal straight alpha",
    "trim": false,
    "atlas_rotation": false
  },
  "mesh_contract": {
    "schema": "deckrogue.contact-mesh.v1",
    "type": "indexed fixed-frame silhouette mesh, not continuous procedural 422 geometry",
    "coordinate_system": "x toward attacker; y screen up; z=0; mesh width=one visible receiver height; root is locked receiving contact",
    "default_texture_scale": "64 native texels per receiver height; prefer integer output scale for pixel preview",
    "layers": "contact material only; no separate runtime light",
    "indices": "triangle list; all vertices have atlas uv; cull disabled",
    "normals": "not used, unshaded; port may supply screen-facing normal",
    "alpha_gain_role": "alpha=1,gain=1,role=material; shader uses authored sRGB RGB",
    "shader_file": "godot/enemy_contact.gdshader",
    "sampler_file": "godot/enemy_contact_sampler.gd",
    "clock": "external age relative to committed contact, not TIME; negative/nonfinite/finished return no mesh",
    "large_mesh_adapter": "indexed mesh expands to triangle soup in 422 Layer: use index count, not unique vertex count; split into at most 510 expanded vertices per 512-capacity batch without splitting triangles",
    "alternatives": "use PNG fallback OR mesh renderer, never both",
    "direct_422_drop_in": false
  },
  "global_contract": {
    "authority": "actual resolved execution and receipt; names are candidate mapping only, never proof",
    "timeline": "contact/confirmed status application starts at age0; no invented windup/projectile/damage",
    "damage_gate": "proven enemy source instance, actual move execution, supported receipt; full block/ice/nullified routes keep their existing defense reaction",
    "status_gate": "curse and roar are hex actions; use actual confirmed effect/application, not DamageDealt-only gate",
    "multiple_hits": "proven individual contributions only; do not replay aggregate plus individual hits; if evidence is insufficient retain original presentation",
    "replacement": "suppress replaced neutral contacts; no duplicate with acid/bell existing routes",
    "placement": "receiving opaque surface, not attacker feet; y basis remains screen up; x basis toward proven attacker",
    "ownership": "stop and clear on interrupt, scene disposal, stale owner/epoch; do not restore or mutate game state",
    "light": "no target light, floor light, bloom or stage focus added; no environmental light timing claimed",
    "reduced_motion": "one short local keyframe or omit motion; never delay game resolution",
    "unmapped": "poison and cold are delivered but not assigned to any current enemy; no color/name inference",
    "excluded_changes": [
      "src/engine",
      "src/data",
      "Unity code",
      "portraits",
      "BGM",
      "key visuals"
    ]
  },
