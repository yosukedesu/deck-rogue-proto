<Project Sdk="Microsoft.NET.Sdk">

  <!-- エンジン等価性検証 (P0スパイク: RNGゴールデンマスター照合)。
       Unityを起動せず dotnet run で実行できる = CIでも回せる。
       エンジン本体は UPMパッケージの Runtime/ をソース参照する (単一ソース維持)。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeckRogue.EngineTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Packages/com.deckrogue.engine/Runtime/**/*.cs" LinkBase="Engine" />
  </ItemGroup>

</Project>
