{
  "_doc": "音の割り当て表 (2026-09-13 音の設計書 docs/audio-design.md)。bgm: 場面→Resources/Audio/bgm/<file> (拡張子なし)。sfx: イベント/UI の鍵→Resources/Audio/sfx/<name> (番号違い _2.._6 は揺らぎ)。素材が無い名前は Synth が合成する。差し替えはこの表を書き換えるだけ",
  "bgm": {
    "title": "title",
    "map1": "map1", "map2": "map2", "map3": "map3",
    "battle1": "battle1", "battle2": "battle2", "battle3": "battle3",
    "elite": null,
    "boss1": "boss1", "boss2": "boss2", "boss3": "boss3",
    "rest": null,
    "won": "title",
    "lost": null
  },
  "sfx": {
    "_doc": "鍵は GameEvent の型名 (例 CardSet)。Presenter が特別扱いする鍵 (DamageDealt.* / TurnStarted / TurnEnded / BlockGained / HpHealed / 状態異常) はコード側が読む。volume は 0〜1、jitter は音程の揺らぎ幅",
    "CardPlayed":        { "sfx": "card_play", "volume": 0.7 },
    "CardsDrawn":        { "sfx": "card_draw", "volume": 0.5 },
    "DeckShuffled":      { "sfx": "card_draw", "volume": 0.6 },
    "CardSet":           { "sfx": "card_set", "volume": 0.7 },
    "ReactionTriggered": { "sfx": "trap_fire", "volume": 0.9, "jitter": 0.02 },
    "ReactionHeld":      { "sfx": "click", "volume": 0.3 },
    "SetCardExpired":    { "sfx": "trap_expire", "volume": 0.7 },
    "SetCardDestroyed":  { "sfx": "trap_break", "volume": 0.8 },
    "ActionNegated":     { "sfx": "negate", "volume": 0.9, "jitter": 0.02 },
    "CardExhausted":     { "sfx": "exhaust", "volume": 0.5 },
    "CardsMilled":       { "sfx": "card_draw", "volume": 0.5 },
    "NecroFired":        { "sfx": "exhaust", "volume": 0.7 },
    "PermanentPlayed":   { "sfx": "permanent", "volume": 0.8 },
    "RetainersTriggered":{ "sfx": "buff", "volume": 0.4 },
    "EnemyIntentDeclared": { "sfx": null },
    "EnemyDied":         { "sfx": "death", "volume": 0.8, "jitter": 0.03 },
    "EnemyFled":         { "sfx": "lunge", "volume": 0.6 },
    "EnemySplit":        { "sfx": "death", "volume": 0.6 },
    "EnemyHatched":      { "sfx": "buff", "volume": 0.7 },
    "EnemyHealed":       { "sfx": "heal", "volume": 0.5 },
    "EnemyStaggered":    { "sfx": "block", "volume": 0.6 },
    "EnemyWoken":        { "sfx": "buff", "volume": 0.7 },
    "GoldStolen":        { "sfx": "gold", "volume": 0.8 },
    "EnergyGained":      { "sfx": "energy", "volume": 0.6 },
    "EnergyMaxGained":   { "sfx": "energy", "volume": 0.8, "jitter": 0.0 },
    "DiscountGained":    { "sfx": "energy", "volume": 0.4 },
    "IceBlockGained":    { "sfx": "block", "volume": 0.6 },
    "BurnTick":          { "sfx": "burn", "volume": 0.5 },
    "ThornsReflected":   { "sfx": "hit", "volume": 0.5 },
    "ScaldTick":         { "sfx": "burn", "volume": 0.5 },
    "AetherDischarged":  { "sfx": "hit_big", "volume": 0.9 },
    "GrowthDischarged":  { "sfx": "hit_big", "volume": 0.9 },
    "MomentumDischarged":{ "sfx": "hit_big", "volume": 0.9 },
    "DeathSaved":        { "sfx": "heal", "volume": 1.0, "jitter": 0.0 },
    "MaxHpGained":       { "sfx": "heal", "volume": 0.8 },
    "RegenTicked":       { "sfx": "heal", "volume": 0.3 },
    "BlockShattered":    { "sfx": "trap_break", "volume": 0.8 },
    "BurrowBroken":      { "sfx": "trap_break", "volume": 0.9 },
    "ArtifactBlocked":   { "sfx": "negate", "volume": 0.5 },
    "PlayerArtifactBlocked": { "sfx": "negate", "volume": 0.5 },
    "SpellEchoed":       { "sfx": "card_play", "volume": 0.6 },
    "TokenDestroyed":    { "sfx": "death", "volume": 0.6 },
    "CombatEnded":       { "sfx": null },
    "_ui": "以下は画面の操作 (Audio.Ui(\"...\") で鳴らす)",
    "ui.click":          { "sfx": "click", "volume": 0.5, "jitter": 0.08 },
    "ui.hover":          { "sfx": "hover", "volume": 0.5, "jitter": 0.1 },
    "ui.pick_card":      { "sfx": "card_play", "volume": 0.7 },
    "ui.pick_relic":     { "sfx": "relic", "volume": 0.8 },
    "ui.buy":            { "sfx": "gold", "volume": 0.8 },
    "ui.remove":         { "sfx": "exhaust", "volume": 0.7 },
    "ui.upgrade":        { "sfx": "forge", "volume": 0.8 },
    "ui.rest":           { "sfx": "rest", "volume": 0.8 },
    "ui.fuse":           { "sfx": "forge", "volume": 0.9 },
    "ui.node":           { "sfx": "map", "volume": 0.8 },
    "ui.event_choice":   { "sfx": "card_play", "volume": 0.6 },
    "ui.start_run":      { "sfx": "turn", "volume": 0.7 },
    "ui.win":            { "sfx": "win", "volume": 0.8, "jitter": 0.0 },
    "ui.lose":           { "sfx": "lose", "volume": 0.8, "jitter": 0.0 }
  }
}
